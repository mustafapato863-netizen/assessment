PORT=8080
# Leave empty or set to /api/v1/assessflow on Vercel / Nginx so browsers use same-origin proxy rewrites
VITE_API_URL=/api/v1/assessflow
CORS_ALLOWED_ORIGINS=https://assess.zainx.cloud,https://assessflow.zainx.cloud,https://web-opal-tau-44.vercel.app,https://web-zain-mustafas-projects.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:3000
DATA_MODE=database
DEFAULT_LOCALE=en
DATABASE_URL=postgresql://postgres:123456@localhost:5432/asses_db # DEV-ONLY temporary; rotate before real deploy
REDIS_URL=redis://localhost:6379
OTEL_SERVICE_NAME=assessflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=
ACCESS_ALLOWED_EMAIL_DOMAIN=saudigerman.com
AUTH_JWT_SECRET=replace-with-a-long-random-secret-before-deployment
HRIS_BASE_URL=
HRIS_CLIENT_ID=
HRIS_CLIENT_SECRET=
STORAGE_CONTAINER_QUARANTINE=assessflow-quarantine
STORAGE_CONTAINER_CLEAN=assessflow-clean
VITE_FEATURE_CALIBRATION=true # Enterprise module: calibration workspace (UX-18)
# Proxies allowed to set X-Forwarded-For (1 behind Nginx/Cloudflare/Vercel; empty = private networks only)
TRUST_PROXY=1
# true lets a System Admin approve cases they scored/finalized (audited as ADMIN_SELF_APPROVAL). Keep false in real use.
ALLOW_ADMIN_SELF_APPROVAL=false
# Local development only: header-based demo sign-in (x-actor-id / x-actor-roles).
# Off by default. pnpm dev turns it on. Never set it in a shared or production environment.
# DEV_AUTH_HEADERS=true
