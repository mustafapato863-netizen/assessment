{
  "name": "@assessflow/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@assessflow/contracts": "workspace:*",
    "@assessflow/database": "workspace:*",
    "bullmq": "^5.58.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "ioredis": "^5.6.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
