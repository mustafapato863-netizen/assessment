{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/assessflow/:path*",
      "destination": "https://bkassess.zainx.cloud/api/v1/assessflow/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://bkassess.zainx.cloud/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://bkassess.zainx.cloud/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
