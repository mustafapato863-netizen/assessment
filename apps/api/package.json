{
  "name": "@assessflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @assessflow/contracts build && nest build",
    "dev": "pnpm --filter @assessflow/contracts build && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@assessflow/contracts": "workspace:*",
    "@assessflow/database": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
